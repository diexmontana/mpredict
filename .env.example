# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube a GitHub.
#   copy .env.example .env        (PowerShell / cmd)

# Administrador de osTicket (se crea en el primer arranque).
# osTicket no acepta el usuario «admin». Contraseña: 8 caracteres o más.
OSTICKET_ADMIN_USER=mpadmin
OSTICKET_ADMIN_PASS=cambia-esta-clave
OSTICKET_ADMIN_EMAIL=admin@example.com

# Base de datos de osTicket (contenedor mpredict-db; no se publica fuera de Docker)
DB_PASS=cambia-esta-clave-db
DB_ROOT_PASS=cambia-esta-clave-root

# Secreto compartido entre mpredict y el complemento de osTicket
# (protege la creación de temas de ayuda). Pon una cadena larga y aleatoria.
MPREDICT_SECRETO=cambia-este-secreto-largo
